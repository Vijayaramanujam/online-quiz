  <script>
    const messageTextarea = document.getElementById('message');
    const charCountSpan = document.getElementById('messageCharCount');
    
    if (messageTextarea && charCountSpan) {
      messageTextarea.addEventListener('input', function() {
        charCountSpan.textContent = this.value.length;
        if (this.value.length > 1000) {
          charCountSpan.style.color = 'red';
        } else if (this.value.length < 20) {
          charCountSpan.style.color = 'orange';
        } else {
          charCountSpan.style.color = 'green';
        }
      });
    }

    function validateContactForm() {
      const email = document.getElementById('contactEmail').value;
      const phone = document.getElementById('contactPhone').value;
      const message = document.getElementById('message').value;
      const inquiryType = document.getElementById('inquiryType').value;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        alert('Please enter a valid email address');
        return false;
      }

      if (phone && !/^\d{10}$/.test(phone)) {
        alert('Please enter a valid 10-digit phone number or leave it empty');
        return false;
      }

      if (message.length < 20) {
        alert('Message must be at least 20 characters long');
        return false;
      }

      if (!inquiryType) {
        alert('Please select an inquiry type');
        return false;
      }

      if (confirm('Are you sure you want to send this message?')) {
        alert('Message sent successfully! We will respond within 24 hours.');
        return true;
      }
      
      return false;
    }

    const contactForm = document.getElementById('contactForm');
    const formInputs = contactForm.querySelectorAll('input:not([type="checkbox"]), textarea, select');
    
    formInputs.forEach(input => {
      const savedValue = localStorage.getItem('contact_' + input.id);
      if (savedValue && input.type !== 'email') {
        input.value = savedValue;
      }
      
      input.addEventListener('change', function() {
        localStorage.setItem('contact_' + input.id, input.value);
      });
    });

    contactForm.addEventListener('submit', function() {
      formInputs.forEach(input => {
        localStorage.removeItem('contact_' + input.id);
      });
    });

    function displayCurrentTime() {
      const now = new Date();
      const hours = now.getHours();
      const day = now.getDay();
      
      let isAvailable = false;
      if (day >= 1 && day <= 6) {
        isAvailable = hours >= 9 && hours < 19;
      } else if (day === 0) {
        isAvailable = hours >= 10 && hours < 17;
      }
      
      const statusElement = document.createElement('p');
      statusElement.className = 'support-status';
      statusElement.innerHTML = isAvailable ? 
        '<strong style="color: green;"> Phone support is currently available</strong>' : 
        '<strong style="color: orange;"> Phone support is currently offline - Please email us</strong>';
      
      const phoneCard = document.querySelector('.contact-card:nth-child(2)');
      if (phoneCard) {
        phoneCard.appendChild(statusElement);
      }
    }

    displayCurrentTime();
  </script>
  <script>
  const menuToggle = document.getElementById('menu-toggle');
  const nav = document.querySelector('nav');
  const hamburger = document.querySelector('.hamburger');
  
  if (hamburger && menuToggle && nav) {
    hamburger.addEventListener('click', function() {
      menuToggle.checked = !menuToggle.checked;
    });
    
    document.addEventListener('click', function(event) {
      const isClickInsideNav = nav.contains(event.target);
      const isClickOnHamburger = event.target.closest('.hamburger');
      
      if (!isClickInsideNav && !isClickOnHamburger && menuToggle.checked) {
        menuToggle.checked = false;
      }
    });
  }
</script>

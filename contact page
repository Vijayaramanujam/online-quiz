        </select>

        <label for="subject">Subject: <span class="required">*</span></label>
        <input type="text" id="subject" name="subject" required minlength="5" maxlength="100" placeholder="Brief subject of your message">

        <label for="message">Message: <span class="required">*</span></label>
        <textarea id="message" name="message" rows="6" required minlength="20" maxlength="1000" placeholder="Please describe your inquiry in detail..."></textarea>
        <p class="char-count">Characters: <span id="messageCharCount">0</span>/1000</p>

        <label for="registrationIdContact">Registration ID (if applicable):</label>
        <input type="text" id="registrationIdContact" name="registrationIdContact" placeholder="Enter if you've already registered">

        <label class="checkbox-label">
          <input type="checkbox" id="subscribeNewsletter" name="subscribeNewsletter">
          Subscribe to newsletter for updates and announcements
        </label>

        <label class="checkbox-label">
          <input type="checkbox" id="agreeCommunication" name="agreeCommunication" required>
          I agree to be contacted via email or phone regarding my inquiry <span class="required">*</span>
        </label>

        <div class="form-actions">
